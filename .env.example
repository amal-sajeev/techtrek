# Copy this file to .env and fill in real values before running the app.
#
# Generate SECRET_KEY with:
#   python -c "import secrets; print(secrets.token_hex(32))"
#
# Generate FIELD_ENCRYPTION_KEY with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

SECRET_KEY=replace_with_64_hex_chars_minimum_32

# PII field encryption key (Fernet, 44-char URL-safe base64).
# Used to encrypt email, username, and full_name at rest in the database.
# KEEP THIS SECRET AND BACK IT UP – losing it makes encrypted data unrecoverable.
FIELD_ENCRYPTION_KEY=replace_with_fernet_key_from_command_above

# Database URL
# PostgreSQL: postgresql+psycopg2://user:password@localhost:5432/techtrek
# SQLite (dev): sqlite:///./techtrek.db
DATABASE_URL=postgresql+psycopg2://postgres:yourpassword@localhost:5432/techtrek

# Razorpay payment gateway (get from https://dashboard.razorpay.com)
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXX
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# First admin user email. Only this email will receive admin on registration.
# Leave empty to use first-registrant-wins (dev only).
ADMIN_BOOTSTRAP_EMAIL=admin@yourdomain.com

# Invoice / Company details
COMPANY_NAME=Your Company Name
COMPANY_ADDRESS=Your Address
COMPANY_GSTIN=
COMPANY_PAN=
COMPANY_EMAIL=billing@yourdomain.com
COMPANY_PHONE=
GST_RATE=18

# SMTP (email sending)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_FROM_NAME=YourApp

# Google SSO (OAuth2) — optional
# Get credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OpenAI — optional (admin certificate designer: “Generate with AI”).
# Two API calls per click (image + vision layout); set key to enable.
# OS environment variables override this file. If you see 401 with an old-looking key, remove OPENAI_API_KEY from Windows/macOS shell or system env.
OPENAI_API_KEY=
# OPENAI_CERT_IMAGE_MODEL=gpt-image-1.5
# OPENAI_CERT_IMAGE_QUALITY=medium
# OPENAI_CERT_LAYOUT_MODEL=gpt-5.4-mini
# Optional: model for admin Metrics “AI report (PDF)” narrative (two-pass); see app.config openai_metrics_report_model.
# Use a chat-completions model your API key supports (e.g. gpt-4o-mini). If the call fails, check server logs and the PDF “AI diagnostic” line.
# OPENAI_METRICS_REPORT_MODEL=gpt-4o-mini

# SSL certificate paths — optional
# Defaults to certs/cert.pem and certs/key.pem if not set.
# Set USE_HTTP=1 to skip SSL entirely.
SSL_CERTFILE=
SSL_KEYFILE=
